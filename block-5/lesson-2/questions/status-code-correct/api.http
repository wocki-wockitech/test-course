### Сценарий A: создание нового пользователя прошло успешно
POST /v1/users HTTP/1.1
Host: api.example.com
Content-Type: application/json

{ "email": "ivan@example.com", "name": "Иван" }

# Ответ сервера:
# HTTP/1.1 ??? 
# Location: /v1/users/42
# Content-Type: application/json
#
# { "id": 42, "email": "ivan@example.com", "name": "Иван" }


### Сценарий B: тело запроса синтаксически корректно, но email уже занят
POST /v1/users HTTP/1.1
Host: api.example.com
Content-Type: application/json

{ "email": "ivan@example.com", "name": "Иван" }

# Ответ сервера:
# HTTP/1.1 ???
# Content-Type: application/json
#
# { "error": "email already registered" }


### Сценарий C: удаление существующего пользователя, тело в ответе не нужно
DELETE /v1/users/42 HTTP/1.1
Host: api.example.com

# Ответ сервера:
